FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeFunc residuals
(
    name    = residuals,
    fields  = (p U)
)

#includeFunc forceCoeffsIncompressible
(
    name    = forceCoeffs,
    patches = (airfoil),
    magUInf = 51.48,
    lRef    = 1,
    Aref    = 1,
    CofR    = (0 0 0),
    liftDir = (0 1 0),
    dragDir = (1 0 0),
    pitchAxis = (0 0 1)
)

