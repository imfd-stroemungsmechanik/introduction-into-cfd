FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 8.58e-6;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 8.58e-6;
        value           uniform 8.58e-6;
    }

    airfoil
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
}

