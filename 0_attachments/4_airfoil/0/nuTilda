FoamFile
{
    format      ascii;
    class       volScalarField;
    object      nuTilda;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 3.432e-5;

boundaryField
{
    farfield
    {
        type            inletOutlet;
        inletValue      uniform 3.432e-5;
        value           uniform 3.432e-5;
    }

    airfoil
    {
        type            fixedValue;
        value           uniform 0;
    }

    frontAndBack
    {
        type            empty;
    }
}

