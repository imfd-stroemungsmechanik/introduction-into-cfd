FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 1e4;

boundaryField
{
    inlet_air
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.04;
        value           uniform 1e4;
    }

    inlet_exhaust
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.02;
        value           uniform 1e4;
    }

    outlet
    {
        type            zeroGradient;
    }

    pipe_air
    {
        type            omegaWallFunction;
        value           uniform 0.1;
    }

    pipe_exhaust
    {
        type            omegaWallFunction;
        value           uniform 0.1;
    }
}


